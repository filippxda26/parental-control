#!/bin/sh /etc/rc.common
START=96
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/parental-control-web
	procd_set_param respawn 3600 5 5
	procd_set_param file /etc/parental-control/settings.json
	procd_close_instance
}

stop_service() {
	service_stop /usr/sbin/parental-control-web
}
